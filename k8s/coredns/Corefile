# Authoritative CoreDNS configuration for be-a.dev registry
# RFC 1035, RFC 1982, RFC 2308, RFC 8482 compliant

be-a.dev:53 {
    log
    errors

    file /etc/coredns/zones/db.be-a.dev {
        reload 5s
    }

    template IN A be-a.dev {
        match ^([a-zA-Z0-9-]+\.)+be-a\.dev\.$
        answer "{{ .Name }} 60 IN A 130.78.191.155"
        fallthrough
    }

    minimal-any
    prometheus :9153
    health :8082
    cache 300
}

